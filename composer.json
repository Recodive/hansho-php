{
    "name": "recodive/hansho",
    "description": "PHP client for the Hansho hub's sender API: pairing, channels, templates, sounds, messages, pages, Live Activities, feeds and webhook verification.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "hansho",
        "notifications",
        "push",
        "pager",
        "webhook"
    ],
    "homepage": "https://github.com/recodive/hansho",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Recodive\\Hansho\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Recodive\\Hansho\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
